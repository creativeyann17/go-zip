#!/bin/sh
# Format + vet + tests (no race) before every commit — the full
# race-detector check runs in CI, not here. Install with `make install-hooks`.
make fmt
git add -u

echo "Running go vet + tests..."
if ! (go vet ./... && go test ./... -count=1); then
    echo ""
    echo "✗ Checks failed. Fix issues above before committing."
    exit 1
fi

exit 0
